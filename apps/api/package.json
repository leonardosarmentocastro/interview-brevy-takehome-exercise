{
  "name": "api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server/start.ts",
    "start": "tsx src/server/start.ts",
    "worker": "tsx src/worker/start.ts",
    "worker:dev": "tsx watch src/worker/start.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "graphile-worker": "^0.17.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
